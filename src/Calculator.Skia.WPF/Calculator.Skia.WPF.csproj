<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <!-- Referencia a los archivos de modelo (se añadirán después) -->
    <Compile Include="Models\*.cs" />
    <Compile Include="ViewModels\*.cs" />
  </ItemGroup>

  <!-- Para depuración local, copia la DLL nativa si existe -->
  <Target Name="CopyNativeDLL" AfterTargets="AfterBuild">
    <Copy SourceFiles="$(SolutionDir)artifacts\CalcManager\CalcManager.Win32.dll" DestinationFolder="$(OutDir)" Condition="Exists('$(SolutionDir)artifacts\CalcManager\CalcManager.Win32.dll')" />
    <Move SourceFiles="$(OutDir)CalcManager.Win32.dll" DestinationFiles="$(OutDir)CalcManager.dll" Condition="Exists('$(OutDir)CalcManager.Win32.dll')" />
  </Target>

</Project>
