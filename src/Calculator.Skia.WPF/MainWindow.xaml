<Window x:Class="Calculator.Skia.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UNO Calculator" Height="400" Width="300">
    <Grid>
        <TextBox Name="Display" FontSize="24" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="50" Margin="10"/>
        <StackPanel Orientation="Vertical" Margin="10,70,10,10">
            <Button Content="1" Click="OnDigitClick"/>
            <Button Content="2" Click="OnDigitClick"/>
            <Button Content="+" Click="OnOperatorClick"/>
            <Button Content="=" Click="OnEqualsClick"/>
        </StackPanel>
    </Grid>
</Window>
